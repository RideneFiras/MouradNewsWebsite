{
  "name": "El Borj: email → draft → approval → site + Facebook",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "sender": "CHANGE_ME@gmail.com",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      },
      "id": "c20ab203-b887-4e78-9d8b-b70a5047d263",
      "name": "New email from the journalist",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// ======= SETTINGS: change these once =======\nconst CONFIG = {\n  approver_email: 'firasuv@gmail.com',            // who gets the approval emails (Firas)\n  allowed_senders: ['CHANGE_ME@gmail.com'],       // the journalist's address(es); also set it in the Gmail trigger\n  facebook_page_id: 'CHANGE_ME',                  // the El Borj Facebook Page id\n  graph_version: 'v24.0',                         // Facebook Graph API version\n  require_dmarc: true,                            // refuse emails Gmail could not authenticate (anti-spoofing)\n};\n// ============================================\n\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json;\n  const from = String(j.from?.value?.[0]?.address || '').toLowerCase();\n  const headers = JSON.stringify(j.headers || {});\n  let rejected = '';\n  if (!CONFIG.allowed_senders.map((s) => s.toLowerCase()).includes(from)) rejected = `the sender ${from || '(unknown)'} is not in allowed_senders`;\n  else if (CONFIG.require_dmarc && !/dmarc=pass|dkim=pass/i.test(headers)) rejected = 'the email did not pass Gmail authentication (DKIM/DMARC); it may be forged. Set require_dmarc to false in «Prepare email» if this is wrong.';\n\n  const images = [];\n  for (const [key, bin] of Object.entries(items[i].binary || {})) {\n    if (!String(bin.mimeType || '').startsWith('image/')) continue;\n    const buf = await this.helpers.getBinaryDataBuffer(i, key);\n    images.push({ filename: bin.fileName || key, mime: bin.mimeType, data: buf.toString('base64') });\n  }\n  const text = j.text || String(j.html || '').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/p>/gi, '\\n\\n').replace(/<[^>]+>/g, '');\n  out.push({ json: { config: CONFIG, rejected, from, message_id: j.messageId || j.id, subject: j.subject || '', text, images, image_count: images.length } });\n}\nreturn out;\n"
      },
      "id": "57d61e0e-0798-45a5-b1c7-3439fd2b4f8e",
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
