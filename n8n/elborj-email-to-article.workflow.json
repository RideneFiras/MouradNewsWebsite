      "id": "fe1e5269-88b2-4eee-8c84-ba3704d23f7e",
      "name": "Post on Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $('Read decision').item.json;\nconst pub = $('Publish (publisher)').item.json;\nlet fb = 'not posted on Facebook (you chose the site only).';\nif (r.decision === 'publish_fb') {\n  const f = $('Post on Facebook').isExecuted ? $('Post on Facebook').item.json : null;\n  fb = f && f.id ? `posted on Facebook (post id ${f.id}).` : `the Facebook post FAILED: ${JSON.stringify(f?.error || f).slice(0, 800)}. Post it by hand with this text:\\n\\n${r.facebook_text}`;\n}\nconst body = pub.ok\n  ? `Published: ${pub.public_url}\\n\\nFacebook: ${fb}`\n  : `Publishing FAILED: ${pub.error}\\nThe article is still a draft: ${r.admin_url}`;\nreturn [{ json: { to: r.approver_email, subject: `البرج: ${pub.ok ? 'published' : 'publishing failed'}: ${r.title}`, body } }];\n"
      },
