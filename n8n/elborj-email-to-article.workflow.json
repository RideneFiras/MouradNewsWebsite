    {
      "parameters": {
        "jsCode": "const p = $('Prepare email').item.json;\nconst r = $json;\nconst subject = r.needs_input ? `البرج: question about «${p.subject}»` : `البرج: the email «${p.subject}» could not be turned into a draft`;\nconst body = r.needs_input\n  ? `Claude did not make a draft from this email and asks:\\n\\n${r.question}\\n\\n${(r.notes || []).map((n) => ' - ' + n).join('\\n')}\\n\\nYou can publish it by hand (/publish-article) or ask the journalist to resend it.`\n  : `The publisher returned an error:\\n\\n${r.error || JSON.stringify(r).slice(0, 2000)}\\n\\nNothing was published. Logs on the server: docker compose -f n8n/docker-compose.yml logs publisher`;\nreturn [{ json: { to: p.config.approver_email, subject, body } }];\n"
      },
