      "id": "e0443da1-5a7d-4ac3-ae7e-2f971900a8cf",
      "name": "Make draft (publisher)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "97c03b6f-d413-4ebc-883c-b53cbbf5a613",
              "leftValue": "={{ $json.ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2f02bcd1-90ff-456d-89cf-b79640cdb9f2",
      "name": "Draft saved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nconst cfg = $('Prepare email').item.json.config;\nconst list = (title, rows) => (rows && rows.length ? `\\n${title}\\n${rows.map((x) => ` - ${x}`).join('\\n')}\\n` : '');\nconst ev = (r.events || []).map((e) => `${e.starts_on}${e.ends_on ? ' → ' + e.ends_on : ''}${e.start_time ? ' ' + e.start_time : ''} «${e.title_ar}»${e.place ? ' · ' + e.place : ''}`);\nconst fixes = (r.corrections || []).map((c) => `«${c.from}» → «${c.to}»${c.why ? ' (' + c.why + ')' : ''}`);\nconst gen = (r.generated || []).includes('subtitle') ? ' (written by Claude)' : '';\nconst message = [\n  `New article from the email «${$('Prepare email').item.json.subject}». It is saved as a DRAFT (not public yet).`,\n  '',\n  `Title: ${r.title}`,\n  `Subtitle${gen}: ${r.subtitle || '(none)'}`,\n  `Section: ${[r.category, ...(r.extra_categories || [])].join(' + ')} · Genre: ${r.format || '-'} · Tags: ${(r.tags || []).join(', ') || '-'}`,\n  r.title_from_subject ? 'The title was taken from the email subject.' : '',\n  list('Pictures:', r.images),\n  list('Added to the calendar (الأجندة):', ev),\n  list('Typo fixes:', fixes),\n  list('Lines left out of the article:', r.skipped_lines),\n  list('Please check:', r.notes),\n  `Word-for-word check: ${r.fidelity}`,\n  '',\n  `Open the draft in the admin: ${r.admin_url}`,\n  '',\n  'Proposed Facebook post (you can edit it in the form):',\n  '-----',\n  r.facebook_post || '(none)',\n  '-----',\n  '',\n  'Press the button, choose what to do and submit.',\n].join('\\n').replace(/\\n{3,}/g, '\\n\\n');\nreturn [{ json: { ...r, approver_email: cfg.approver_email, approval_subject: `البرج: ${r.title}`, approval_message: message } }];\n"
      },
      "id": "9bcfb724-9acf-4b48-b176-24fd85ed3321",
      "name": "Approval text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $json.approver_email }}",
        "subject": "={{ $json.approval_subject }}",
        "message": "={{ $json.approval_message }}",
        "responseType": "customForm",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Publish + Facebook"
                  },
                  {
                    "option": "Publish on the site only"
                  },
                  {
                    "option": "Keep as draft"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Facebook text",
              "fieldType": "textarea",
              "defaultValue": "={{ $json.facebook_post }}"
            }
          ]
        },
        "options": {
          "messageButtonLabel": "Review and decide",
          "responseFormTitle": "El Borj: publish this article?",
          "responseFormButtonLabel": "Submit",
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 7,
              "resumeUnit": "days"
            }
          }
        }
      },
      "id": "80beba97-8442-4dfb-8d65-04b5c13921b1",
      "name": "Ask Firas",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1320,
        100
      ],
      "webhookId": "bdf2f491-1264-491c-9f3f-f5c3d34d4935"
    },
    {
      "parameters": {
        "jsCode": "const d = $json.data || {};\nconst pick = (re) => { const k = Object.keys(d).find((k) => re.test(k)); return k ? String(d[k] ?? '') : ''; };\nconst choice = pick(/decision/i);\nconst r = $('Approval text').item.json;\nconst decision = choice.startsWith('Publish + Facebook') ? 'publish_fb' : choice.startsWith('Publish') ? 'publish' : 'draft';\nreturn [{ json: { ...r, decision, facebook_text: pick(/facebook/i).trim() || r.facebook_post } }];\n"
      },
