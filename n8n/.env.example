# Copy to n8n/.env on the server and fill in. Never commit n8n/.env.
# (Comments on their own lines only: Docker reads the whole line as the value.)

# Your DuckDNS name
DOMAIN=elborj-n8n.duckdns.org
# openssl rand -hex 32  (keep a copy in your password manager)
N8N_ENCRYPTION_KEY=
# openssl rand -hex 32  (also pasted into the n8n "Publisher" credential)
PUBLISHER_TOKEN=

# Which model writes the drafts: openai or anthropic
LLM_PROVIDER=openai
# platform.openai.com → API keys
OPENAI_API_KEY=
# The model chosen in the local test (pnpm -s publisher:try --models)
OPENAI_MODEL=gpt-5.5
# Only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Same values as in .env.local on Firas's machine
NEXT_PUBLIC_SUPABASE_URL=https://knxuskjqpsimptwxqfju.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PROD_REVALIDATE_SECRET=
