{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "www",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Workers Paid (2026-10-03): up to 30 s of CPU per request (a page build needs well under 1 s).
  "limits": { "cpu_ms": 30000 },
  // Minify the Worker script at deploy (keeps it well under the free-plan size limit).
  "minify": true,
  "services": [
    // Self-reference, must match "name" above (OpenNext caching).
    { "binding": "WORKER_SELF_REFERENCE", "service": "www" }
  ],
  "r2_buckets": [
    // Create once: npx wrangler r2 bucket create el-borj-opennext-cache
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "el-borj-opennext-cache" }
  ],
  "d1_databases": [
    // Create once: npx wrangler d1 create el-borj-tag-cache  -> paste the id below.
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "el-borj-tag-cache",
      "database_id": "c3b834aa-6110-492a-b348-5e2f3af1ddf5"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    // Public, non-secret values. Secrets: see docs/DEPLOY.md (wrangler secret put).
    "SITE_URL": "https://www.elborj.workers.dev",
    // Background page refresh (Durable Object queue): a rebuild of the homepage can take more than
    // the 10 s default, and every failed attempt is retried with a full re-render (6 by default),
    // which multiplied CPU use on the Free plan (error 1102, 2026-10-03). Allow 30 s, retry once.
    "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "30000",
    "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "1",
    "NEXT_PUBLIC_SUPABASE_URL": "https://knxuskjqpsimptwxqfju.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtueHVza2pxcHNpbXB0d3hxZmp1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA4NzU0NzAsImV4cCI6MjEwNjQ1MTQ3MH0.poi9MIh2ykUKuuZK246cDul2xj7RCdDbO5bj6_2pras"
  }
}
