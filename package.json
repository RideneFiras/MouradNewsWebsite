{
  "name": "el-borj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bash scripts/deploy.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/db-test.sh",
    "db:bundle": "tsx scripts/build-all-migrations.ts",
    "bundle:size": "tsx scripts/bundle-size.ts",
    "db:demo": "tsx scripts/generate-demo-seed.ts",
    "publish:article": "tsx scripts/publish-article.ts",
    "backfill:share": "tsx scripts/backfill-share-images.ts",
    "dev:users": "tsx scripts/dev-users.ts",
    "db:local-reset": "bash scripts/local-reset.sh",
    "dev:traffic": "bash scripts/simulate-traffic.sh"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "isbot": "5.2.2",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@opennextjs/cloudflare": "1.20.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}
