# Copy to .env.local for local development (never commit .env.local).
# On Cloudflare: public values go in wrangler.jsonc "vars", secrets via
#   npx wrangler secret put NAME
# NEXT_PUBLIC_* values are also inlined at build time, so set them in the
# shell (or .env.production.local) before `pnpm build:cf`.

# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> "Publishable key"
# (sb_publishable_...). The legacy "anon" JWT key also works until Supabase retires it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# SECRET, server only. Supabase dashboard -> Project Settings -> API Keys ->
# "Secret key" (sb_secret_...) or legacy "service_role". Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# SECRET. Any long random string, e.g. `openssl rand -hex 32`.
# Protects /api/revalidate (also used by the pg_net call from the database, see supabase/APPLY.md).
REVALIDATE_SECRET=REPLACE_WITH_RANDOM_HEX

# SECRET. Any long random string, e.g. `openssl rand -hex 32`.
# Signs the analytics/ads page tokens and admin preview links.
TRACKER_HMAC_SECRET=REPLACE_WITH_RANDOM_HEX

# Public canonical origin, no trailing slash. Your domain once it is live.
SITE_URL=http://localhost:3000
